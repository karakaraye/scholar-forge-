# ==================================================================
# ScholarForge AI - Docker Compose environment (production-style)
# Copy to infrastructure/.env and fill in. Never commit the real file.
# ==================================================================

# --- Public address ---------------------------------------------------
# Local test of the production stack:
SITE_ADDRESS=http://localhost
PUBLIC_URL=http://localhost
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Real deployment (Caddy fetches a TLS certificate automatically):
# SITE_ADDRESS=app.example.com
# PUBLIC_URL=https://app.example.com
# DJANGO_ALLOWED_HOSTS=app.example.com,backend

# Secure cookies. Keep True; browsers accept them on http://localhost too.
COOKIES_SECURE=True

# --- Secrets ----------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-long-random-value
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=scholarforge_db
POSTGRES_USER=scholarforge_user

# --- Email (invitations, password reset) -----------------------------
# Leave EMAIL_HOST empty to print emails to the backend logs instead.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ScholarForge AI <no-reply@example.com>

# --- AI ---------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# False = use the live model when OPENAI_API_KEY is set.
AI_MOCK_MODE=False
SEMANTIC_SCHOLAR_API_KEY=

# --- Advanced ---------------------------------------------------------
# Only set when the API is served from a different origin than the app.
NEXT_PUBLIC_API_URL=
HTTP_PORT=80
HTTPS_PORT=443
