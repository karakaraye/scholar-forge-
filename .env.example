# ==================================================
# ScholarForge AI - Stage 1 Environment Variables
# ==================================================

# Django Backend Configuration
DJANGO_SECRET_KEY=scholarforge-insecure-production-key-replace-me-12345
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend

# Database Configuration (PostgreSQL)
DB_ENGINE=postgresql
POSTGRES_DB=scholarforge_db
POSTGRES_USER=scholarforge_user
POSTGRES_PASSWORD=scholarforge_secure_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Security & Sessions
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Private user files (uploads + generated DOCX/PDF exports).
# Defaults to backend/media when unset; point at a persistent volume in production.
# DJANGO_MEDIA_ROOT=/var/lib/scholarforge/media

# ==================================================
# Stage 2: AI Academic Writing Assistant
# ==================================================
# Set OPENAI_API_KEY to your valid OpenAI API key for live generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=1500
OPENAI_TIMEOUT=30
# Set to True for deterministic mock generation during development.
# When unset, the test suite uses the mock engine automatically; an explicit value always wins.
AI_MOCK_MODE=True

