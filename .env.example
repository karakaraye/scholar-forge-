# ==================================================================
# ScholarForge AI - local development environment
# Copy to .env in the repository root. For the Docker production stack
# use infrastructure/.env.example instead.
# ==================================================================

# --- Django -----------------------------------------------------------
# DEBUG defaults to False when unset; keep True for local development.
DJANGO_DEBUG=True
# Required when DJANGO_DEBUG=False. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=local-dev-only-replace-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---------------------------------------------------------
# Comment out DB_ENGINE and all POSTGRES_* lines to use SQLite (backend/db.sqlite3).
DB_ENGINE=postgresql
POSTGRES_DB=scholarforge_db
POSTGRES_USER=scholarforge_user
POSTGRES_PASSWORD=scholarforge_secure_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Web app origin ---------------------------------------------------
# Used for links in emails and added to the CORS / CSRF allow-lists automatically.
FRONTEND_URL=http://localhost:3000
# Extra allowed browser origins (comma-separated). Defaults to localhost:3000 / 127.0.0.1:3000.
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Secure (HTTPS-only) cookies default to True whenever DJANGO_DEBUG is False.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# --- Files & exports --------------------------------------------------
# Private uploads and generated DOCX/PDF exports. Defaults to backend/media.
# DJANGO_MEDIA_ROOT=/var/lib/scholarforge/media
# sync   = render exports inside the request (default in development)
# worker = queue them for `python manage.py run_export_worker` (default when DEBUG is off)
# EXPORT_JOB_MODE=sync

# --- Email ------------------------------------------------------------
# Leave EMAIL_HOST empty to print emails (invitations, password resets) to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ScholarForge AI <no-reply@localhost>

# --- AI ---------------------------------------------------------------
# With a key and AI_MOCK_MODE=False, the writing assistant, literature intelligence,
# results interpretation, AI review and feedback analysis use the live model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=1500
OPENAI_TIMEOUT=30
# True = deterministic offline output. When unset, tests use mock mode automatically.
AI_MOCK_MODE=True
SEMANTIC_SCHOLAR_API_KEY=
